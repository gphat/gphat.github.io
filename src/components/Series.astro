---
// "This post is part of…" box. Rendered at the top (margin on wide screens) and bottom of a post.
// The current part is highlighted (bold + "← you are here") and is not a link.
import Icon from "./Icon.astro";
import type { Series } from "../lib/series";

interface Props extends Series {
  currentUrl: string;
  position?: "top" | "bottom";
}
const { name, description, note, parts, currentUrl, position = "top" } = Astro.props;
const idx = parts.findIndex((p) => p.url === currentUrl);
---
<aside class:list={["series", "series--" + position]} aria-label={name + " series"}>
  <p class="series__head label" style="color: var(--ink); font-style: normal">
    <Icon name="layers" size={14} /> {name}{idx >= 0 && " · part " + (idx + 1) + " of " + parts.length}
  </p>
  <p>This post is part of {description}.</p>
  <ol>
    {parts.map((p, i) => (
      i === idx
        ? <li aria-current="page">{p.title}</li>
        : <li><a href={p.url}>{p.title}</a></li>
    ))}
  </ol>
  {note && <p class="series__note">{note}</p>}
</aside>
