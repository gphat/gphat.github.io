---
// One page of the post list. Page 1 is /, the rest are /page2/, /page3/, …
// (jekyll-paginate's paths, which old links still use).
import Base from "../layouts/Base.astro";
import { fmtDate, getPosts, postPath, PER_PAGE } from "../lib/posts";

interface Props {
  page: number;
}

const { page } = Astro.props;
const posts = await getPosts();
const totalPages = Math.ceil(posts.length / PER_PAGE);
const shown = posts.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const pagePath = (n: number) => (n === 1 ? "/" : `/page${n}/`);
---
<Base path={pagePath(page)}>
  <p class="mb-3 prose prose-neutral lg:prose-lg dark:prose-invert prose-a:text-rose-500">I'm Cory, a senior infrastructure engineer based in Nashville, TN. I build reliable systems and think hard about the product experience around them — because great infra is nothing if nobody can use it.</p>

  <h1 class="text-2xl font-bold">Posts</h1>

  <ul class="-mx-3 mt-3 space-y-3">
    {shown.map((post) => (
      <li class="p-3 rounded-md hover:bg-gray-50 dark:hover:bg-zinc-950">
        <a class="space-y-1.5" href={postPath(post)}>
          <span class="border-l-2 pl-3 text-sm text-gray-400 border-gray-200 dark:border-zinc-700">{fmtDate(post.data.date)}</span>
          <h3 class="text-lg font-semibold">{post.data.title}</h3>
          {post.data.summary && <p class="text-gray-400 text-sm">{post.data.summary}</p>}
          <p class="flex items-center text-rose-500">Read article →</p>
        </a>
      </li>
    ))}
  </ul>

  <nav class="mt-3 flex items-center justify-between border-t border-gray-200 dark:border-zinc-700 py-3 sm:px-6" aria-label="Pagination">
    <p class="text-sm text-gray-700">Showing page <span class="font-medium">{page}</span> of <span class="font-medium">{totalPages}</span></p>
    <div class="flex flex-1 justify-between sm:justify-end gap-3">
      {page > 1 && <a href={pagePath(page - 1)} class="rounded-md px-3 py-2 text-sm font-semibold ring-1 ring-inset ring-gray-300 dark:ring-zinc-700">Previous</a>}
      {page < totalPages && <a href={pagePath(page + 1)} class="rounded-md px-3 py-2 text-sm font-semibold ring-1 ring-inset ring-gray-300 dark:ring-zinc-700">Next</a>}
    </div>
  </nav>

  <p class="my-3">Subscribe <a href="/feed.xml">via RSS</a></p>
</Base>
