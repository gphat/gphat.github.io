---
// One page of the post list. Page 1 is /, the rest are /page2/, /page3/, …
// (jekyll-paginate's paths, which old links still use). Five posts per page;
// on page 1 the newest is the feature block and the other four are listed.
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import { fmtDate, getPosts, postPath, PER_PAGE } from "../lib/posts";
import { categoryTopic, TOPICS } from "../lib/topics";

interface Props {
  page: number;
}

const { page } = Astro.props;
const posts = await getPosts();
const lastPage = Math.ceil(posts.length / PER_PAGE);
const shown = posts.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const pagePath = (n: number) => (n === 1 ? "/" : `/page${n}/`);
const prevUrl = page > 1 ? pagePath(page - 1) : undefined;
const nextUrl = page < lastPage ? pagePath(page + 1) : undefined;

const isFirst = page === 1;
const lead = isFirst ? shown[0] : undefined;
const list = isFirst ? shown.slice(1) : shown;

// The feature block wears its post's topic colour and screen, as its card
// does; posts outside the topics get the lead teal and its rings.
const leadTopicKey = lead && categoryTopic(lead.data.categories);
const leadTopic = leadTopicKey ? TOPICS[leadTopicKey] : undefined;
const leadColor = leadTopic?.color ?? "teal";
const leadScreen = leadTopic?.screen ?? "wave";
---
<Base path={pagePath(page)}>
  <div class="wrap">
    {isFirst && (
      <section class="intro" aria-label="About this site">
        <p class="intro__mark t-display title-shadow" aria-label="One Mo' 'Gin">One mo' 'gin<sup aria-hidden="true">†</sup></p>
        <p class="intro__gloss"><b>†</b> <em>'gin</em>, as in again. Say it “one more again.”</p>
        <p class="intro__blurb">I'm Cory, an engineer based in Nashville. I build reliable systems, music players, and other things people use, and I think hard about the experience around them.</p>
      </section>
    )}

    {lead && (
      <article class={`feature block block--${leadColor}`}>
        <span class={`ht ht--${leadScreen}`} aria-hidden="true"></span>
        <span class="label" style="color: inherit">Latest &middot; <time datetime={lead.data.date.toISOString()}>{fmtDate(lead.data.date)}</time></span>
        <h2 class="feature__title t-display"><a href={postPath(lead)}>{lead.data.title}</a></h2>
        {lead.data.summary && <p>{lead.data.summary} <a href={postPath(lead)}>Read it</a></p>}
      </article>
    )}

    <section class="post-list" aria-labelledby="posts-heading">
      <div class="post-list__head">
        <h2 id="posts-heading" class="label" style="margin:0; color: var(--ink)">{isFirst ? "And again…" : "Posts"}</h2>
      </div>
      <ol>
        {list.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
            <h3 class="post-list__title"><a href={postPath(p)}>{p.data.title}</a></h3>
            {p.data.summary && <p class="post-list__summary">{p.data.summary}</p>}
          </li>
        ))}
      </ol>
    </section>

    <nav class="pagination" aria-label="Pagination">
      <span>{prevUrl && <a class="prev" href={prevUrl}><Icon name="arrow-left" size={14} /> Newer</a>}</span>
      <span class="status">Page {page} of {lastPage}</span>
      <span class="next">{nextUrl && <a href={nextUrl}>Older <Icon name="arrow-right" size={14} /></a>}</span>
    </nav>

    {isFirst && (
      <nav class="topics" aria-label="Topics">
        {Object.values(TOPICS).map((t) => (
          <a class={`block block--${t.color}`} href={t.href}><span class={`ht ht--topic ht--${t.screen}`} aria-hidden="true"></span><span class="t-head">{t.label}</span><small>since {t.since} →</small></a>
        ))}
      </nav>
    )}
  </div>
</Base>
