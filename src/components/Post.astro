---
// Post template body, rendered by src/pages/[...slug].astro.
import Icon from "./Icon.astro";
import Series from "./Series.astro";
import type { Series as SeriesData } from "../lib/series";

interface Props {
  title: string;
  date: Date;
  description?: string;
  url: string;
  series?: SeriesData;
  feedbackUrl?: string;
}
const { title, date, description, url, series, feedbackUrl = "https://github.com/gphat/feedback/issues/new" } = Astro.props;
const fmt = date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<article class="post">
  <header class="post-header wrap">
    <span class="ht ht--dots" aria-hidden="true"></span>
    <span class="label">
      {series && <><Icon name="layers" size={13} /> {series.name} &middot; </>}
      <time datetime={date.toISOString()}>{fmt}</time>
    </span>
    <h1 class="t-display title-shadow">{title}</h1>
    {description && <p class="deck">{description}</p>}
  </header>

  <div class="wrap"><hr class="rule-hatch" /></div>

  <div class="wrap">
    <div class="post-body">
      {series && <Series {...series} currentUrl={url} position="top" />}
      <div class="prose">
        <slot />
      </div>

      <footer class="post-end">
        {series && <Series {...series} currentUrl={url} position="bottom" />}
        <div class="post-actions">
          <a href={feedbackUrl}><Icon name="message-square" size={15} /> Leave me feedback</a>
          <a class="rss-cta" href="/feed.xml"><Icon name="rss" size={15} /> Like what you're reading? Subscribe via RSS</a>
        </div>
      </footer>
    </div>
  </div>
</article>

<!-- Margin notes: clones footnotes beside their paragraph on wide screens. ~1KB, no dependencies. -->
<script is:inline>
  (function () {
    var body = document.querySelector(".post-body");
    var prose = body && body.querySelector(".prose");
    if (!prose) return;
    var refs = prose.querySelectorAll("a[data-footnote-ref], a.footnote");
    if (!refs.length) return;
    // A footnote cited more than once gets one margin note, beside its first citation.
    var seen = {};
    refs.forEach(function (ref) {
      var id = decodeURIComponent((ref.getAttribute("href") || "").slice(1));
      var li = id && document.getElementById(id);
      if (!li || seen[id]) return;
      seen[id] = true;
      var note = document.createElement("aside");
      note.className = "sidenote";
      note.setAttribute("aria-hidden", "true");
      var num = document.createElement("span");
      num.className = "sidenote__num";
      num.textContent = ref.textContent.trim();
      note.appendChild(num);
      var clone = li.cloneNode(true);
      clone.querySelectorAll("a[data-footnote-backref], a.reversefootnote").forEach(function (a) { a.remove(); });
      while (clone.firstChild) note.appendChild(clone.firstChild);
      var block = ref;
      while (block.parentElement && block.parentElement !== prose) block = block.parentElement;
      if (block.parentElement === prose) prose.insertBefore(note, block);
    });
    body.classList.add("has-sidenotes");
  })();
</script>
