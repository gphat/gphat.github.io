---
// Layout for the Markdown pages under src/pages (About, Observability, Resilience).
import Base from "./Base.astro";

const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title}>
  <article class="prose prose-neutral lg:prose-lg dark:prose-invert prose-a:text-rose-500">
    <header>
      <h1>{frontmatter.title}</h1>
    </header>
    <slot />
  </article>
</Base>
