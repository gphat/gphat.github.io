---
// Layout for the pages under src/pages (About, the topic pages).
// Frontmatter: title, optional description, optional topic (a key of SECTIONS):
// the header is that section's colour block and screen, as on its nav chip and
// (for topics) its home-page block.
import Base from "./Base.astro";
import { SECTIONS, type SectionKey } from "../lib/topics";

const { title, description, topic: topicKey } = Astro.props.frontmatter;
const topic = topicKey ? SECTIONS[topicKey as SectionKey] : undefined;
---
<Base title={title} description={description}>
  {topic ? (
    <div class="wrap">
      <header class:list={["page-header", "page-header--topic", "block", `block--${topic.color}`]}>
        <span class:list={["ht", "ht--topic", `ht--${topic.screen}`]} aria-hidden="true"></span>
        {"since" in topic && <span class="label">Topic · since {topic.since}</span>}
        <h1 class="t-display title-shadow">{title}</h1>
      </header>
    </div>
  ) : (
    <header class="page-header wrap">
      <span class="ht" aria-hidden="true"></span>
      <h1 class="t-display title-shadow">{title}</h1>
    </header>
  )}
  <div class="wrap">
    <div class="page-body prose">
      <slot />
    </div>
    <slot name="after" />
  </div>
</Base>
