---
// Base shell: header (wordmark + nav), main slot, footer.
import Icon from "../components/Icon.astro";
import { SITE_TITLE, SITE_DESCRIPTION, EMAIL, GITHUB_USERNAME, LINKEDIN_USERNAME, TITLE_IMAGE } from "../consts";
import { TOPICS } from "../lib/topics";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  // The canonical path. Pass it from routes whose URL ends in .html, since
  // Astro.url doesn't carry the extension.
  path?: string;
}

const { title, description, image, path = Astro.url.pathname } = Astro.props;
const canonical = new URL(path, Astro.site);
const imageUrl = new URL(image ?? TITLE_IMAGE, Astro.site);

// Topic links wear their topic's block colour (see .site-nav a[data-topic]).
const nav: { href: string; label: string; topic?: string }[] = [
  ...Object.values(TOPICS).map((t) => ({ href: t.href, label: t.label, topic: t.color })),
  { href: "/about", label: "About" },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + "/");
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Set theme before paint: stored choice, else OS preference. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3VKN4BGJPL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-3VKN4BGJPL");
    </script>

    <title>{title ?? SITE_TITLE}</title>
    <meta name="description" content={description ?? SITE_DESCRIPTION} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed.xml" />

    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={description ?? SITE_DESCRIPTION} />
    <meta name="twitter:image" content={imageUrl} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Source Serif 4, variable: the full weight range in roman and true italic. -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap" />
    <link rel="stylesheet" href="/styles/onemogin.css" />
    <link rel="preload" href="/fonts/Parkly-Soft.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Parkly-WideSoft.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">{SITE_TITLE}</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} data-topic={n.topic} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
          <a class="icon-btn" href="/feed.xml" title="RSS feed"><Icon name="rss" size={16} label="RSS feed" /></a>
          <button class="icon-btn theme-toggle" type="button" aria-label="Toggle dark mode">
            <Icon name="moon" size={16} class="icon-moon" />
            <Icon name="sun" size={16} class="icon-sun" />
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <span class="ht ht--dots ht--reverse" aria-hidden="true"></span>
      <div class="wrap">
        <span>Field notes on systems and sound, by Cory Watson. &copy; {year}</span>
        <ul class="social">
          <li><a href={`mailto:${EMAIL}`}><Icon name="mail" size={18} label="Email" /></a></li>
          <li><a href={`https://github.com/${GITHUB_USERNAME}`}><Icon name="github" size={18} label="GitHub" /></a></li>
          <li><a href={`https://linkedin.com/in/${LINKEDIN_USERNAME}`}><Icon name="linkedin" size={18} label="LinkedIn" /></a></li>
        </ul>
        <p class="colophon">
          Set in <a href="https://simplebits.com">Parkly</a> by Dan Cederholm of SimpleBits,
          <a href="https://github.com/adobe-fonts/source-serif">Source Serif 4</a>, and
          <a href="https://github.com/tywr/Nordwand-Mono">Nordwand Mono</a>. Inked in the spirit of
          Nashville’s <a href="https://hatchshowprint.com">Hatch Show Print</a>.
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        var root = document.documentElement;
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        function current() { return root.dataset.theme || (mq.matches ? "dark" : "light"); }
        btn.setAttribute("aria-pressed", String(current() === "dark"));
        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          btn.setAttribute("aria-pressed", String(next === "dark"));
          try { localStorage.setItem("theme", next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
